# 🌐 SERVIDOR
PORT=4000
NODE_ENV=development

# 🗄️ BANCO DE DADOS (MySQL local)
DB_NAME=bubble_db
DB_USER=root
DB_PASS=aluno
DB_HOST=localhost
DB_DIALECT=mysql

# 💾 OPÇÃO ALTERNATIVA (caso queira usar uma única URL em vez das variáveis acima)
# DATABASE_URL=mysql://root:123456789@localhost:3306/bubble_db
# DATABASE_URL=sqlite:./db/bubble_db.sqlite
# DATABASE_URL=postgres://usuario:senha@localhost:5432/bubble_db

# 🔑 JWT (Autenticação)
JWT_SECRET=sua_chave_super_secreta_aqui
JWT_EXPIRES_IN=7d

# 📂 UPLOADS (pastas do projeto)
UPLOADS_PATH=uploads
USERS_UPLOADS_PATH=uploads/users
BANNERS_UPLOADS_PATH=uploads/users/banner
TEMPS_UPLOADS_PATH=uploads/temps

# 🧩 OUTROS (opcionais)
# FRONTEND_URL=http://localhost:5173

# 🌐 SERVIDOR
PORT=4000
NODE_ENV=development

# 🗄️ BANCO DE DADOS
DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASS=senha_do_banco
DB_HOST=localhost
DB_DIALECT=mysql
# Se quiser usar DATABASE_URL única (exemplo para PostgreSQL ou SQLite):
# DATABASE_URL=sqlite:./src/db/database.sqlite
# DATABASE_URL=postgres://usuario:senha@localhost:5432/nome_do_banco

# 🔑 JWT (Autenticação)
JWT_SECRET=sua_chave_super_secreta_aqui
JWT_EXPIRES_IN=7d

# 📁 UPLOADS
UPLOADS_PATH=src/uploads
USERS_UPLOADS_PATH=src/uploads/users
TEMPS_UPLOADS_PATH=src/uploads/temps
POSTS_UPLOADS_PATH=src/uploads/posts

# 🧩 OUTROS (opcional)
# FRONTEND_URL=http://localhost:5173
# LOG_LEVEL=info
